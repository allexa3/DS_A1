# Copy to .env and change the passwords/secrets. Do not quote values or put spaces around '='.
GATEWAY_PORT=80
TRAEFIK_DASHBOARD_PORT=8090

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=change-me-auth

USER_DB_NAME=user_db
USER_DB_USER=user_app
USER_DB_PASSWORD=change-me-user

DEVICE_DB_NAME=device_db
DEVICE_DB_USER=device_app
DEVICE_DB_PASSWORD=change-me-device

# JWT signing key: at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRATION_MINUTES=60

# First administrator, created at startup (password: at least 6 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
